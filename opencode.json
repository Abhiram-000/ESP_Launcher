        },
        "kiro/minimax-m2.5": {
          "name": "Kiro MiniMax M2.5"
        },
        "kiro/qwen3-coder-next": {
          "name": "Kiro Qwen3 Coder Next"
        },
        "gemini-cli/gemini-1.5-flash": {
          "name": "Gemini CLI 1.5 Flash"
        },
        "gemini-cli/gemini-3-flash-preview": {
          "name": "Gemini CLI 3 Flash Preview"
        },
        "gemini-cli/gemini-3.1-flash-lite-preview": {
          "name": "Gemini CLI 3.1 Flash Lite Preview"
        },
        "gemini/gemini-2.0-flash": {
          "name": "Gemini 2.0 Flash"
        },
        "gemini/gemini-2.5-flash": {
          "name": "Gemini 2.5 Flash"
        },
        "gemini/gemini-2.5-flash-lite": {
          "name": "Gemini 2.5 Flash Lite"
        },
        "gemini/gemini-3-flash-preview": {
          "name": "Gemini 3 Flash Preview"
        },
        "gemini/gemini-3.1-flash-lite": {
          "name": "Gemini 3.1 Flash Lite"
        },
        "gemini/gemini-3.5-flash": {
          "name": "Gemini 3.5 Flash"
        },
        "gemini/gemini-flash-latest": {
          "name": "Gemini Flash Latest"
        },
        "gemini/gemini-flash-lite-latest": {
          "name": "Gemini Flash Lite Latest"
        },
        "gemini/gemini-robotics-er-1.6-preview": {
          "name": "Gemini Robotics ER 1.6 Preview"
        },
        "gemini/gemma-4-26b-a4b-it": {
          "name": "Gemma 4 26B"
        },
        "gemini/gemma-4-31b-it": {
