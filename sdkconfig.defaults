# =============================================================================
# sdkconfig.defaults — ESP32-S3 Custom Launcher
# =============================================================================
# These values are merged with ESP-IDF defaults on first build (or after
# 'pio run -t clean'). Edit here rather than in sdkconfig directly.
# =============================================================================

# Flash size — ESP32-S3-N16R8 has 16 MB. The board definition defaults to 8 MB;
# override here so the bootloader and partition table match.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"

# ---- OTA Safety ----
# Rollback: if a new app crashes before marking itself valid, bootloader
# automatically reverts to the previous good partition.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Skip the factory app slot — we use ota_0 as our "factory" partition.
CONFIG_BOOTLOADER_FACTORY_RESET=n

# Reserve RTC FAST memory for bootloader–app communication.
# This enables rtc_retain_mem_t used by our custom GPIO hook
# (boot_gpio_hook.c + boot_ctrl.cpp) to pass the SELECT-held state
# across the bootloader→app boundary. Size = 8 bytes for future flags.
CONFIG_BOOTLOADER_CUSTOM_RESERVE_RTC=y
CONFIG_BOOTLOADER_CUSTOM_RESERVE_RTC_SIZE=0x8

# ---- Bootloader GPIO trigger (built-in ESP-IDF mechanism as backup) ----
# This is in addition to our custom hook, providing a redundant safe path.
# Holding GPIO 16 for 3s at boot triggers factory partition / ota_0.
# Disable if it conflicts, but having it as a backup is defense-in-depth.
CONFIG_BOOTLOADER_NUM_PIN_FACTORY_RESET=16
CONFIG_BOOTLOADER_HOLD_TIME_GPIO=3
CONFIG_BOOTLOADER_WDT_ENABLE=y

# ---- Partition Table ----
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# ---- System ----
CONFIG_ESP_SYSTEM_PANIC_PRINT_REBOOT=y
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=30

# ---- Log level ----
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_COLORS=y

# ---- Optimization ----
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# ---- PSRAM (8MB Octal ESP32-S3) ----
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
# Allocations larger than 16KB will automatically go to PSRAM
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384

# ---- mbedTLS: use PSRAM for TLS handshake buffers (~40KB) ----
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

# ---- NVS encryption off (API key stored plaintext in NVS for now) ----
CONFIG_NVS_ENCRYPTION=n

# ---- SNTP / NTP Time Service ----
CONFIG_LWIP_SNTP_MAX_SERVERS=3
CONFIG_LWIP_SNTP_UPDATE_DELAY=3600000
CONFIG_LWIP_SNTP_STARTUP_DELAY=y
CONFIG_LWIP_SNTP_MAXIMUM_STARTUP_DELAY=5000
CONFIG_SNTP_TIME_SYNC_METHOD_IMMED=y
CONFIG_NEWLIB_TIME_SYSCALL_USE_HRT=y

